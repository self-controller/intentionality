{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "intentionality",
  "version": "0.5.0",
  "identifier": "dev.intentionality.board",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Intentionality", "width": 1180, "height": 760, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "icon": ["icons/icon.png"]
  }
}
